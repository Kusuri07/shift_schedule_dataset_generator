{
  "storage_root": "D:\\harudam_model",
  "dataset": {
    "synthetic_schedules": 10000,
    "ood_layout_schedules": 200,
    "real_schedules": 300,
    "real_photos": 1000,
    "master_split": "D:\\harudam_model\\training_dataset\\splits\\master_split.jsonl",
    "charset": "data/korean_charset_v1.txt",
    "on_the_fly_augmentation": true
  },
  "models": {
    "dbnet": {"architecture": "MobileNetV3-FPN", "best_metric": "text_polygon_hmean_iou_0_5"},
    "recognizer": {"architecture": "MobileNetV3-BiLSTM-CTC", "best_metric": "cell_exact_accuracy", "tie_breaker": "cer"},
    "table": {"architecture": "MobileNetV3-FPN", "top_k": 2048, "attention_feature": "1/16", "dense_heads_feature": "1/4", "best_metric": "0.6*cell_polygon_f1+0.4*row_level_accuracy"}
  },
  "fine_tuning": {
    "synthetic_pretraining": true,
    "real_photo_fine_tuning": true,
    "gradual_unfreezing": ["head", "last_backbone_stage", "all"],
    "crop_mix_initial": {"gt": 0.6, "jitter": 0.3, "strong": 0.1},
    "crop_mix_after_table": {"gt": 0.5, "jitter": 0.3, "table_prediction": 0.2}
  },
  "selection": {
    "cv": "train-only grouped 3-fold",
    "architecture_threshold_route_quantization": "real validation only",
    "test": "one final evaluation",
    "ood_layout": "reporting only"
  }
}
